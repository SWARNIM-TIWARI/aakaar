# ──────────────────────────────────────────────
# AAKAAR — आकार — Environment Variables
# Copy this file to .env.local and fill in values.
# Keys marked [SERVER ONLY] must NEVER go in NEXT_PUBLIC_* vars.
# ──────────────────────────────────────────────

# ── Reasoning Provider ────────────────────────
# Options: demo | openai-compatible | evon-local
# - demo            : fully deterministic, no keys needed
# - openai-compatible : any OpenAI-API-compatible endpoint (Together, Groq, etc.)
# - evon-local      : an optional local OpenAI-style endpoint (Ollama, LM Studio). Nothing here
#                     claims a particular model is available; use whichever you run yourself
REASONING_PROVIDER=demo

# ── OpenAI-compatible provider [SERVER ONLY] ──
# Required only when REASONING_PROVIDER=openai-compatible
# Groq example (checked against Groq's model and deprecation pages on 7 Nov 2026):
#   openai/gpt-oss-120b is Production and is Groq's named replacement for retired models.
#   openai/gpt-oss-20b is the faster, cheaper fallback.
#   llama-3.3-70b-versatile and llama-3.1-8b-instant were scheduled to shut down on 16 Aug 2026.
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_API_KEY=your_key_here
OPENAI_COMPATIBLE_MODEL=openai/gpt-oss-120b
# Optional. Reasoning models spend tokens thinking, so the default budget is 4096.
# OPENAI_COMPATIBLE_MAX_TOKENS=4096
# OPENAI_COMPATIBLE_REASONING_EFFORT=low
# OPENAI_COMPATIBLE_JSON_MODE=true

# ── Evon local [SERVER ONLY] ─────────────────
# Required only when REASONING_PROVIDER=evon-local
# Point to your local Ollama or LM Studio endpoint
EVON_LOCAL_BASE_URL=http://localhost:11434/v1
EVON_LOCAL_MODEL=your_local_model_name

# ── Gnani Speech APIs [SERVER ONLY] ──────────
# Required only for live voice transcription and synthesis.
# Leave blank to use browser SpeechRecognition fallback.
# Register at: https://gnani.ai
GNANI_API_KEY=
# Defaults below are the correct production endpoints — only override for testing.
# Auth header is X-API-Key-ID (not Bearer). Key must stay SERVER-SIDE only.
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# ── App config ───────────────────────────────
NEXT_PUBLIC_APP_NAME=AAKAAR
# Set to "true" to show the demo banner prominently
NEXT_PUBLIC_SHOW_DEMO_BANNER=true